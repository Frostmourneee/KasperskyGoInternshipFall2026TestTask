# Скопируйте файл в .env и задайте два разных секрета.
# Для каждого значения выполните: openssl rand -hex 32
# Пароль входит в URL: используйте только буквы и цифры, например hex.
POSTGRES_PASSWORD=
API_KEY=

HTTP_READ_TIMEOUT=5s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
REQUEST_TIMEOUT=10s
SHUTDOWN_TIMEOUT=10s
DB_CONNECT_TIMEOUT=10s
DB_MAX_CONNS=10
MAX_BODY_BYTES=16384
RATE_LIMIT=10
RATE_BURST=20
LOG_LEVEL=info
